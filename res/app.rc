#include <windows.h>
#include "../src/resource.h"

IDI_APP ICON "app.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VW_VERSION_MAJOR, VW_VERSION_MINOR, VW_VERSION_PATCH, 0
 PRODUCTVERSION VW_VERSION_MAJOR, VW_VERSION_MINOR, VW_VERSION_PATCH, 0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "FileDescription",  "Video Wallpaper - video em loop na area de trabalho"
            VALUE "FileVersion",      VW_VERSION_STR
            VALUE "InternalName",     "VideoWallpaper"
            VALUE "OriginalFilename", "VideoWallpaper.exe"
            VALUE "ProductName",      "Video Wallpaper"
            VALUE "ProductVersion",   VW_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
